# Anthropic API Key for Claude (optional; used by textual-change fingerprint extractor)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Corpus Supabase (documents, hawk-dove scores, calendar_ingest_runs)
SUPABASE_URL=https://your-corpus-project.supabase.co
SUPABASE_KEY=your-corpus-anon-or-service-key
DATABASE_URL=postgresql://postgres:your-password@db.your-corpus-project.supabase.co:5432/postgres

# Calendar Supabase (read-only speaker_events in the economic event calendar project)
CALENDAR_SUPABASE_URL=https://your-calendar-project.supabase.co
CALENDAR_SUPABASE_KEY=your-calendar-read-key
